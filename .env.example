# Copy this file to .env and update the values below

# Application Settings
APP_NAME=DocuQuest
APP_KEY=
APP_ENV=development
APP_BASE_URL=
CORS_ALLOWED_ORIGINS=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=docuquest
DB_CHARSET=utf8mb4
DB_PREFIX=
DB_SSL_CA=

# Gmail SMTP notifications (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=DocuQuest

# PayMongo Hosted Checkout (keep both secrets server-side)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=gcash,card,qrph

# Private document storage: local (default) or s3-compatible object storage
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_ENDPOINT=
DOCUMENT_STORAGE_PREFIX=request-files
DOCUMENT_STORAGE_PATH_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
GOOGLE_CLIENT_ID=